# Database Configuration
# For local development with Docker: use the default values below
# For production: use your PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/associationhub"

# NextAuth Configuration
# Generate with: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-here-generate-with-openssl-rand-base64-32"

# Encryption Key (for encrypting sensitive data like SMTP passwords in database)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CRITICAL: Keep this secret and never commit to version control
# Must be 64 hex characters (32 bytes)
ENCRYPTION_KEY="your-64-character-hex-key-here-generate-with-command-above"

# SMTP Configuration (now stored in database via Settings page)
# Configure your SMTP settings through the app UI at /dashboard/settings
# Supported providers: Gmail (with App Password), Outlook, SendGrid, custom SMTP
# No environment variables needed - all configuration is database-backed

# Vercel Blob Storage (for file uploads)
# Get from: https://vercel.com/dashboard/stores
# Optional for local development
BLOB_READ_WRITE_TOKEN="your-vercel-blob-token"
