// Prisma schema for AssociationHub MVP - Many-to-Many Version
// Single-tenant architecture (one association per deployment)
// Members can have multiple roles and belong to multiple groups

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User: Single admin user for MVP (single-tenant)
model User {
  id             String          @id @default(cuid())
  email          String          @unique
  password       String          // bcrypt hashed
  name           String
  createdAt      DateTime        @default(now())
  emailCampaigns EmailCampaign[]

  @@index([email])
}

// Role: Dynamic roles stored in database (not enum)
// Enables different association types (parents, sports, cultural)
model Role {
  id          String       @id @default(cuid())
  name        String       @unique // e.g., "delegue_titulaire", "entraineur"
  displayName String       // e.g., "Délégué titulaire", "Entraîneur"
  sortOrder   Int          // Display order in UI
  members     MemberRole[] // Many-to-many relation

  @@index([name])
}

// GroupType: Dynamic groups stored in database with hierarchical structure
// Enables classes, teams, sections depending on association type
// Supports parent-child relationships (e.g., "6ème" → "6ème 1")
model GroupType {
  id       String        @id @default(cuid())
  name     String        @unique // e.g., "6e1", "poussins", "debutant"
  category String        // e.g., "classe", "equipe", "section"
  parentId String?       // Optional parent group for hierarchical structure
  parent   GroupType?    @relation("GroupHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children GroupType[]   @relation("GroupHierarchy") // Child groups
  members  MemberGroup[] // Many-to-many relation with members

  @@index([name])
  @@index([category])
  @@index([parentId])
}

// Member: Individual belonging to the association
model Member {
  id        String        @id @default(cuid())
  name      String
  email     String        @unique
  roles     MemberRole[]  // Many-to-many relation with roles
  groups    MemberGroup[] // Many-to-many relation with groups
  createdAt DateTime      @default(now())

  @@index([email])
}

// Junction table for Member-Role many-to-many relationship
model MemberRole {
  id       String   @id @default(cuid())
  memberId String
  roleId   String
  member   Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  role     Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@unique([memberId, roleId]) // Prevent duplicate role assignments
  @@index([memberId])
  @@index([roleId])
}

// Junction table for Member-Group many-to-many relationship
model MemberGroup {
  id       String    @id @default(cuid())
  memberId String
  groupId  String
  member   Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  group    GroupType @relation(fields: [groupId], references: [id], onDelete: Cascade)
  joinedAt DateTime  @default(now())

  @@unique([memberId, groupId]) // Prevent duplicate group assignments
  @@index([memberId])
  @@index([groupId])
}

// EmailCampaign: Record of a mass email sent
model EmailCampaign {
  id             String   @id @default(cuid())
  subject        String
  bodyTemplate   String   @db.Text // Email body with template tags
  attachmentUrl  String?  // URL to PDF attachment (Vercel Blob)
  recipientCount Int      // Number of recipients
  sentAt         DateTime @default(now())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sentAt])
}

// SMTPConfiguration: SMTP credentials for email sending
// Stored in database with encryption for BYO SMTP model
model SMTPConfiguration {
  id        String   @id @default(cuid())
  host      String   // SMTP server host (e.g., smtp.gmail.com)
  port      Int      // SMTP port (e.g., 587)
  user      String   // SMTP username/email
  password  String   // Encrypted password (AES-256-GCM)
  fromEmail String   // From email address
  fromName  String   // From name
  userId    String   @unique // One SMTP config per user (single-tenant)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}
